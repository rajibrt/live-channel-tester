SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key
PUBLIC_PLAYLIST_BASE_URL=https://your-vercel-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_FACEBOOK_INBOX_URL=https://www.facebook.com/your-page-or-inbox-link
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8787
CRON_SECRET=replace_with_long_random_secret
CRON_CHECK_TIMEOUT_SEC=8
CRON_CHECK_CONCURRENCY=6
CRON_CHECK_LIMIT=0
# Replace these with real VAPID keys (do not keep placeholders).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Optional Android native app install URL (APK/Play Store listing).
NEXT_PUBLIC_ANDROID_APP_URL=https://example.com/webtvbd.apk
# Capacitor Android wrapper config
CAP_APP_ID=com.webtvbd.app
CAP_APP_NAME=WEBTVBD
CAP_SERVER_URL=https://webtvbd.com
# Optional: override auto build version label in Docker/Dokploy build.
APP_BUILD_VERSION=

# Optional metadata fallback providers for movie import.
OMDB_API_KEY=9df3aeb9
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
MOVIE_METADATA_TIMEOUT_MS=12000

# Movie importer (Apache/FTP directory listing) defaults.
MOVIE_IMPORT_BASE_URL=http://10.1.1.1/data/
MOVIE_IMPORT_INCLUDE=movies
MOVIE_IMPORT_EXCLUDE=android games,software,tv shows,series
MOVIE_IMPORT_LIMIT=0
MOVIE_IMPORT_MAX_DEPTH=6
MOVIE_IMPORT_PUBLISH=true
MOVIE_METADATA_PROVIDERS=imdb,omdb,tmdb

# Optional: external LAN transcode gateway (for unsupported audio on domain playback).
# Example: https://transcode.webtvbd.com/api/stream-transcode
STREAM_TRANSCODE_GATEWAY_URL=
STREAM_TRANSCODE_GATEWAY_TOKEN=
STREAM_TRANSCODE_FORCE_VIDEO_REENCODE=true

# Optional: force compatibility mode for all movies on client.
NEXT_PUBLIC_STREAM_ALWAYS_COMPAT_MODE=false

# Object storage backend for uploaded media.
# OBJECT_STORAGE_PROVIDER: "supabase" (default) or "s3-compatible"
OBJECT_STORAGE_PROVIDER=supabase
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_USE_PATH_STYLE=true
OBJECT_STORAGE_SIGNED_READ_URLS=true
OBJECT_STORAGE_SIGNED_READ_EXPIRY_SECONDS=86400
OBJECT_STORAGE_BUCKET_IMAGES=
OBJECT_STORAGE_BUCKET_VIDEOS=

# Optional per-feature bucket overrides.
LOGO_BUCKET=
OG_IMAGE_BUCKET=
ARTICLE_IMAGE_BUCKET=

# AI article draft generation
AI_ARTICLE_PROVIDER=gemini
AI_ARTICLE_API_KEY=
AI_ARTICLE_MODEL=gemini-2.0-flash
AI_ARTICLE_BASE_URL=https://generativelanguage.googleapis.com/v1
